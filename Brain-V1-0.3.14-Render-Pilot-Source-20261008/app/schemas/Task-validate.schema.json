{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "new_evidence": {
      "const": []
    },
    "evidence_validation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          },
          "supported_by_raw": {
            "type": "boolean"
          },
          "context_preserved": {
            "type": "boolean"
          },
          "attribution_correct": {
            "type": "boolean"
          },
          "constructs_separated": {
            "type": "boolean"
          },
          "suspicious": {
            "type": "boolean"
          },
          "unknown_only": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "evidence_id",
          "valid",
          "supported_by_raw",
          "context_preserved",
          "attribution_correct",
          "constructs_separated",
          "suspicious",
          "unknown_only",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "evidence_status": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "UNKNOWN",
              "UNCERTAIN",
              "INVALID",
              "RETRACTED",
              "SUPERSEDED"
            ]
          },
          "reason": {
            "type": "string"
          },
          "clarifying_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "evidence_id",
          "status",
          "reason",
          "clarifying_evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "student_state_updates": {
      "const": []
    },
    "active_hypotheses": {
      "const": []
    },
    "supporting_evidence_ids": {
      "const": []
    },
    "contradicting_evidence_ids": {
      "const": []
    },
    "confidence_updates": {
      "const": []
    },
    "missing_information": {
      "const": []
    },
    "next_action": {
      "const": ""
    },
    "next_question_intent": {
      "const": ""
    },
    "small_insight_ready": {
      "const": false
    },
    "mirror_ready": {
      "const": false
    },
    "mirror_candidate": {
      "const": null
    },
    "direction_ready": {
      "const": false
    },
    "direction_candidates": {
      "const": []
    },
    "micro_experience_update": {
      "const": null
    },
    "stop_reason": {
      "const": null
    },
    "task_data": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "new_evidence",
    "evidence_validation",
    "evidence_status",
    "student_state_updates",
    "active_hypotheses",
    "supporting_evidence_ids",
    "contradicting_evidence_ids",
    "confidence_updates",
    "missing_information",
    "next_action",
    "next_question_intent",
    "small_insight_ready",
    "mirror_ready",
    "mirror_candidate",
    "direction_ready",
    "direction_candidates",
    "micro_experience_update",
    "stop_reason",
    "task_data"
  ],
  "additionalProperties": false
}