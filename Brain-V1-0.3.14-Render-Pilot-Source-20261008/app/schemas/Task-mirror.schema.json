{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "new_evidence": {
      "const": []
    },
    "evidence_validation": {
      "const": []
    },
    "evidence_status": {
      "const": []
    },
    "student_state_updates": {
      "const": []
    },
    "active_hypotheses": {
      "const": []
    },
    "supporting_evidence_ids": {
      "const": []
    },
    "contradicting_evidence_ids": {
      "const": []
    },
    "confidence_updates": {
      "const": []
    },
    "missing_information": {
      "const": []
    },
    "next_action": {
      "const": ""
    },
    "next_question_intent": {
      "const": ""
    },
    "small_insight_ready": {
      "type": "boolean"
    },
    "mirror_ready": {
      "type": "boolean"
    },
    "mirror_candidate": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "output_id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "SMALL_INSIGHT",
                "WEAK_HYPOTHESIS",
                "MIRROR"
              ]
            },
            "text": {
              "type": "string"
            },
            "claim": {
              "type": "string"
            },
            "context_scope": {
              "type": "string"
            },
            "hypothesis_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "uncertainty_explicit": {
              "type": "boolean"
            }
          },
          "required": [
            "output_id",
            "kind",
            "text",
            "claim",
            "context_scope",
            "hypothesis_ids",
            "evidence_ids",
            "uncertainty_explicit"
          ],
          "additionalProperties": false
        }
      ]
    },
    "direction_ready": {
      "const": false
    },
    "direction_candidates": {
      "const": []
    },
    "micro_experience_update": {
      "const": null
    },
    "stop_reason": {
      "const": null
    },
    "task_data": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "new_evidence",
    "evidence_validation",
    "evidence_status",
    "student_state_updates",
    "active_hypotheses",
    "supporting_evidence_ids",
    "contradicting_evidence_ids",
    "confidence_updates",
    "missing_information",
    "next_action",
    "next_question_intent",
    "small_insight_ready",
    "mirror_ready",
    "mirror_candidate",
    "direction_ready",
    "direction_candidates",
    "micro_experience_update",
    "stop_reason",
    "task_data"
  ],
  "additionalProperties": false
}